import os

Import("env")
with open(env["PROJECT_TOOL_S"]) as project_tools:
    exec(project_tools.read())

if "CONFIG_TOOLCHAIN_PREFIX" in os.environ:
    env["RANLIB"] = '${_concat(GCCPREFIX, "ranlib", GCCSUFFIX, __env__)}'
    env["RANLIBCOM"] = "$RANLIB $TARGET"
    env["ARFLAGS"] = ["rcs"]

SRCS = Glob("src/*.c*")
INCLUDE = [ADir("."), ADir("include")]
PRIVATE_INCLUDE = []
REQUIREMENTS = ["lvgl_component", "pthread"]
if "CONFIG_V9_5_LV_USE_SDL" not in os.environ:
    REQUIREMENTS += ["input", "xkbcommon", "udev", "dl", "camera", "camera-base"]
STATIC_LIB = []
DYNAMIC_LIB = []
DEFINITIONS = ["-std=c++17"]
if "CONFIG_V9_5_LV_USE_SDL" in os.environ:
    DEFINITIONS += ["-DORBIT_DESKTOP_SIMULATOR=1"]
DEFINITIONS_PRIVATE = []
LDFLAGS = []
if "CONFIG_V9_5_LV_USE_SDL" not in os.environ:
    LDFLAGS += ["-lutil", "-Wl,--allow-shlib-undefined"]
LINK_SEARCH_PATH = []
STATIC_FILES = []
MULTIARCH_INCLUDE = None

sysroot_candidates = []
if "CONFIG_TOOLCHAIN_SYSROOT" in os.environ:
    sysroot_candidates.append(os.environ["CONFIG_TOOLCHAIN_SYSROOT"].strip('"'))
project_sysroot = os.path.join(env["PROJECT_PATH"], "static_lib")
if os.path.isdir(project_sysroot):
    sysroot_candidates.append(project_sysroot)

for sysroot in sysroot_candidates:
    sysroot_include = os.path.join(sysroot, "usr", "include")
    if os.path.isdir(sysroot_include):
        INCLUDE += [sysroot_include]
    multiarch_include = os.path.join(sysroot, "usr", "include", "aarch64-linux-gnu")
    if os.path.isdir(multiarch_include):
        INCLUDE += [multiarch_include]
        MULTIARCH_INCLUDE = multiarch_include
    multiarch_lib = os.path.join(sysroot, "usr", "lib", "aarch64-linux-gnu")
    if os.path.isdir(multiarch_lib):
        LDFLAGS += [f"--sysroot={sysroot}", f"-B{multiarch_lib}",
                    f"-Wl,-rpath-link,{multiarch_lib}"]
        LINK_SEARCH_PATH += [multiarch_lib]
    if MULTIARCH_INCLUDE:
        break

lvgl_component = next(component for component in env["COMPONENTS"] if component["target"] == "lvgl_component")
if MULTIARCH_INCLUDE:
    for component in env["COMPONENTS"]:
        component["INCLUDE"] += [MULTIARCH_INCLUDE]
if "CONFIG_V9_5_LV_USE_SDL" in os.environ:
    lvgl_component["REQUIREMENTS"] += ["SDL2"]
    lvgl_component["INCLUDE"] += ["/usr/include/SDL2"]
    for include_path in [
        "/opt/homebrew/include",
        "/opt/homebrew/include/SDL2",
        "/usr/local/include",
        "/usr/local/include/SDL2",
    ]:
        if os.path.exists(include_path):
            lvgl_component["INCLUDE"] += [include_path]
    for library_path in ["/opt/homebrew/lib", "/usr/local/lib"]:
        if os.path.exists(library_path):
            lvgl_component["LINK_SEARCH_PATH"] += [library_path]
    lvgl_component["DEFINITIONS"] += ["-D_REENTRANT"]
    for source in list(lvgl_component["SRCS"]):
        if "lv_sdl_keyboard.c" in str(source):
            lvgl_component["SRCS"].remove(source)

env["COMPONENTS"].append(
    {
        "target": "M5CardputerZero-AstroBox",
        "SRCS": SRCS,
        "INCLUDE": INCLUDE,
        "PRIVATE_INCLUDE": PRIVATE_INCLUDE,
        "REQUIREMENTS": REQUIREMENTS,
        "STATIC_LIB": STATIC_LIB,
        "DYNAMIC_LIB": DYNAMIC_LIB,
        "DEFINITIONS": DEFINITIONS,
        "DEFINITIONS_PRIVATE": DEFINITIONS_PRIVATE,
        "LDFLAGS": LDFLAGS,
        "LINK_SEARCH_PATH": LINK_SEARCH_PATH,
        "STATIC_FILES": STATIC_FILES,
        "REGISTER": "project",
    }
)
